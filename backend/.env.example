# Environment variables for the Budgeter backend
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/budgeter

# ── Auth0 ─────────────────────────────────────────────────────────────────────
# Your Auth0 tenant domain (no https://)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# The API identifier registered in the Auth0 dashboard
AUTH0_AUDIENCE=https://your-api-identifier

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false

# Comma-separated list of origins allowed by CORS
# Example: http://localhost:5173,https://app.yourdomain.com
ALLOWED_ORIGINS=["http://localhost:5173"]
