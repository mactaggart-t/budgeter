# Vite environment variables for the Budgeter frontend
# Copy this file to .env.local – Vite will pick it up automatically.
# Never commit .env.local to version control.

# ── Auth0 ─────────────────────────────────────────────────────────────────────
# Your Auth0 tenant domain (no https://)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Single-Page Application client ID from the Auth0 dashboard
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# The API audience – must match the backend's AUTH0_AUDIENCE
VITE_AUTH0_AUDIENCE=https://your-api-identifier
